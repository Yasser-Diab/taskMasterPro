flutter/ephemeral/

# Visual Studio user-specific files.
*.suo
*.user
*.userosscache
*.sln.docstates

# Visual Studio build-related files.
x64/
x86/

# Keep the architecture-specific WebView2 loader libraries used by CMake.
!third_party/webview2/sdk/build/native/x64/
!third_party/webview2/sdk/build/native/x64/**
!third_party/webview2/sdk/build/native/x86/
!third_party/webview2/sdk/build/native/x86/**

# Visual Studio cache files
# files ending in .cache can be ignored
*.[Cc]ache
# but keep track of directories ending in .cache
!*.[Cc]ache/

# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
/tmp/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/android/build/

# Clean rebuild: the corrupted predecessor remains available locally only.
/old/

# Local configuration, secrets, and generated platform state.
.env
.env.*
!.env.example
*.jks
*.keystore
android/key.properties
/.release-secrets/
/.release-staging/
/release/*
!/release/README.md

# Local archival data and device-capture evidence. These are intentionally
# retained on the workstation but must never become release/source artifacts.
/tool/backups/
/tool/__pycache__/
/phone*.xml
/phone*.png
/[0-9A-Fa-f]*-*.xml
/[0-9A-Fa-f]*-*.png
/-
